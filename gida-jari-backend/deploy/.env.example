# Gida Jari - configuration de la preproduction
# Copier ce fichier en ".env" (cp .env.example .env) puis remplacer chaque valeur.
# Ne JAMAIS envoyer le fichier .env sur Git ou par message.

# Adresse du site :
#  - avec un domaine : preprod.gidajari.com   (HTTPS automatique)
#  - premier essai sans domaine : :80         (HTTP sur l'IP du serveur)
SITE_ADDRESS=preprod.gidajari.com
# URL publique complete (meme valeur que ci-dessus avec https://, ou http://IP-DU-SERVEUR)
PUBLIC_URL=https://preprod.gidajari.com

# Mot de passe PostgreSQL : genere avec   openssl rand -base64 24
DB_PASSWORD=A_REMPLACER
# Cle de signature des sessions (JWT) : genere avec   openssl rand -base64 48
JWT_SECRET=A_REMPLACER
# Secret du callback Mobile Money : genere avec   openssl rand -hex 24
MOMO_WEBHOOK_SECRET=A_REMPLACER

# Numeros administrateurs (validation KYC, litiges), separes par des virgules
ADMIN_PHONES=+22790000000

# Code de connexion : email (par defaut) ou sms
OTP_CANAL=email

# Emails : simulation (code affiche dans les logs) ou smtp (envoi reel)
EMAIL_MODE=smtp
EMAIL_FROM=souradjimohamadou@gmail.com
EMAIL_FROM_NAME=Gida Jari
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) ou aucune
SMTP_SECURITE=starttls
SMTP_USER=souradjimohamadou@gmail.com
SMTP_PASSWORD=mwguradzqgozoylg

# SMS (notifications) : simulation (logs) ou http (agregateur SMS)
SMS_MODE=simulation
SMS_URL=https://CHANGE_ME
SMS_API_KEY=CHANGE_ME

# Mobile Money : simulation (paiements confirmes immediatement) ou operateur
MOMO_MODE=simulation